    "expected_services": [
      "SAP AI Core service instance",
      "Authentication service where applicable",
      "Approved logging or observability service"
    ]
  },
  "remaining_manual_steps": [
    "Create or select the SAP BTP Cloud Foundry space.",
    "Create the required SAP service instances.",
    "Bind service instances to the application.",
    "Review application roles and least-privilege access.",
    "Deploy the approved application package.",
    "Verify the health and readiness endpoints.",
    "Run a post-deployment governance smoke test."
  ]
